---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.jsx";
import Footer from "../../components/Footer.jsx";
import PortableText from "../../lib/sanity/portableText.astro";
import "../../global.css";
import { sanityClient } from "../../lib/sanity/client";
import { postBySlugQuery, postSlugsQuery } from "../../lib/sanity/queries";

/**
 * Statically-generated insight post routes fed by Sanity.
 * At build time this route enumerates all published post slugs and
 * renders one page per post. Same visual template as the legacy static
 * .astro insights.
 */
export async function getStaticPaths() {
  const slugs = await sanityClient.fetch<string[]>(postSlugsQuery);
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const post = await sanityClient.fetch<any>(postBySlugQuery, { slug });

if (!post) {
  return Astro.redirect("/our-work", 302);
}

const seoTitle = post.seoTitle || `${post.title} — ENTEVATE`;
const seoDescription = post.seoDescription || post.excerpt || "";
const publishDate = post.publishDate ? new Date(post.publishDate) : null;
const publishDateFormatted = publishDate
  ? publishDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })
  : "";
const heroTag = post.tags?.[0] || "Insight";
const url = `https://www.entevate.com/insights/${slug}`;

// Estimate reading time from block count (~120 words/block avg).
const readMinutes = Math.max(1, Math.round((post.body?.length || 20) * 0.7));

const jsonLd = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": post.title,
    "description": seoDescription,
    "url": url,
    "datePublished": post.publishDate,
    "author": { "@type": "Organization", "name": "ENTEVATE" },
    "publisher": {
      "@type": "Organization",
      "name": "ENTEVATE",
      "logo": { "@type": "ImageObject", "url": "https://www.entevate.com/favicon.png" },
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.entevate.com" },
      { "@type": "ListItem", "position": 2, "name": "Insights", "item": "https://www.entevate.com/our-work" },
      { "@type": "ListItem", "position": 3, "name": post.title, "item": url },
    ],
  },
]);
---

<BaseLayout title={seoTitle} description={seoDescription} ogType="article" jsonLd={jsonLd}>
  <style>
    .hero {
      background:
        linear-gradient(
          135deg,
          rgba(10, 30, 50, 0.82) 0%,
          rgba(20, 70, 100, 0.65) 50%,
          rgba(36, 123, 150, 0.35) 100%
        ),
        url("/images/bg-blue.png") center/cover no-repeat;
      position: relative;
      overflow: hidden;
      padding: 96px 48px 112px;
      min-height: 60vh;
      display: flex;
      align-items: center;
    }
    .hero-inner {
      position: relative;
      z-index: 2;
      max-width: 1160px;
      margin: 0 auto;
      width: 100%;
    }
    .breadcrumb {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 12px;
      font-weight: 500;
      color: rgba(255, 255, 255, 0.55);
      margin-bottom: 22px;
    }
    .breadcrumb a { color: rgba(255,255,255,0.55); transition: color var(--tr); }
    .breadcrumb a:hover { color: rgba(255,255,255,0.9); }
    .breadcrumb-sep { opacity: 0.4; }
    .hero-eyebrow {
      display: inline-flex; align-items: center; gap: 8px;
      font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
      background: rgba(36, 123, 150, 0.18);
      border: 1px solid rgba(36, 123, 150, 0.4);
      padding: 6px 16px; border-radius: 100px; margin-bottom: 24px;
      color: rgba(255, 255, 255, 0.92);
    }
    .hero-eyebrow-dot {
      width: 7px; height: 7px; border-radius: 50%;
      background: linear-gradient(135deg, #247b96, #5ba8c4);
      flex-shrink: 0;
    }
    .hero h1 {
      font-size: clamp(26px, 5vw, 58px);
      font-weight: 100; line-height: 1.08;
      color: var(--white); margin-bottom: 22px;
      letter-spacing: -0.03em; max-width: 820px; text-wrap: balance;
    }
    .hero-meta { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
    .hero-meta-item {
      font-size: 13px; color: rgba(255,255,255,0.55);
      display: flex; align-items: center; gap: 6px;
    }
    .hero-meta-item svg { opacity: 0.6; }
    .hero-meta-divider { width: 1px; height: 14px; background: rgba(255,255,255,0.2); }

    .article-wrap {
      max-width: 1160px; margin: 0 auto; padding: 80px 48px;
      display: grid; grid-template-columns: 1fr 340px; gap: 72px; align-items: start;
    }
    .article-body { min-width: 0; }
    .article-body :global(h2) {
      font-size: clamp(22px, 2.8vw, 30px);
      font-weight: 300; letter-spacing: -0.02em; line-height: 1.2;
      color: var(--black); margin-bottom: 14px; margin-top: 52px;
    }
    .article-body :global(h2):first-child { margin-top: 0; }
    .article-body :global(h3) {
      font-size: 20px; font-weight: 500; letter-spacing: -0.01em;
      color: var(--black); margin-top: 36px; margin-bottom: 12px;
    }
    .article-body :global(h4) {
      font-size: 16px; font-weight: 600; color: var(--black);
      margin-top: 28px; margin-bottom: 10px;
    }
    .article-body :global(p) {
      font-size: 16px; color: #3d3d3d; line-height: 1.82; margin-bottom: 20px;
    }
    .article-body :global(ul), .article-body :global(ol) {
      padding-left: 22px; margin-bottom: 20px;
    }
    .article-body :global(li) {
      font-size: 16px; color: #3d3d3d; line-height: 1.75; margin-bottom: 8px;
    }
    .article-body :global(a) { color: var(--blue); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }
    .article-body :global(strong) { color: var(--black); font-weight: 600; }
    .article-body :global(.pt-quote) {
      border-left: 3px solid var(--blue);
      background: linear-gradient(135deg, rgba(36,123,150,0.06), rgba(91,168,196,0.04));
      border-radius: 0 var(--radius) var(--radius) 0;
      padding: 24px 28px; margin: 36px 0;
    }
    .article-body :global(.pt-quote p) {
      font-size: 18px; font-weight: 300; font-style: italic;
      color: var(--black); line-height: 1.65; margin: 0; letter-spacing: -0.01em;
    }

    .article-sidebar { position: sticky; top: 90px; display: flex; flex-direction: column; gap: 24px; }
    .sidebar-card {
      background: var(--light-blue); border: 1px solid var(--border);
      border-radius: var(--radius); padding: 24px;
    }
    .sidebar-card h4 {
      font-size: 11px; font-weight: 700; letter-spacing: 0.12em;
      text-transform: uppercase; color: var(--gray-light); margin-bottom: 16px;
    }
    .sidebar-tag {
      display: inline-flex; align-items: center; gap: 6px;
      font-size: 12px; font-weight: 600; padding: 6px 12px; border-radius: 100px;
      background: linear-gradient(90deg, rgba(36,123,150,0.12), rgba(91,168,196,0.12));
      color: var(--blue);
      border: 1px solid rgba(36,123,150,0.25);
      margin-bottom: 12px;
    }
    .sidebar-meta { font-size: 13px; color: var(--gray-mid); line-height: 1.7; }
    .sidebar-meta strong { color: var(--black); font-weight: 500; }
    .sidebar-divider { height: 1px; background: var(--border); margin: 14px 0; }

    .sidebar-cta {
      background: linear-gradient(135deg, rgba(10,30,50,0.92) 0%, rgba(36,123,150,0.88) 100%);
      border-radius: var(--radius); padding: 24px; color: var(--white);
    }
    .sidebar-cta h4 {
      font-size: 15px; font-weight: 400; line-height: 1.4;
      margin-bottom: 10px; color: var(--white); letter-spacing: 0; text-transform: none;
    }
    .sidebar-cta p { font-size: 13px; color: rgba(255,255,255,0.68); line-height: 1.6; margin-bottom: 18px; }
    .btn-blue {
      font-family: var(--font); font-size: 13px; font-weight: 600;
      padding: 11px 20px; border-radius: var(--radius); border: none; cursor: pointer;
      background: var(--white); color: var(--blue); transition: all var(--tr);
      display: inline-block; width: 100%; text-align: center;
    }
    .btn-blue:hover { background: var(--light-blue); transform: translateY(-1px); }

    .cta-band {
      background:
        linear-gradient(135deg, rgba(10,30,50,0.92) 0%, rgba(20,70,100,0.86) 50%, rgba(36,123,150,0.8) 100%),
        url("/images/bg-blue.png") center/cover no-repeat;
      color: var(--white); padding: 80px 48px; text-align: center;
    }
    .cta-band h2 { font-size: clamp(28px, 4vw, 48px); font-weight: 300; letter-spacing: -0.02em; margin-bottom: 14px; }
    .cta-band p { font-size: 16px; color: rgba(255,255,255,0.65); max-width: 500px; margin: 0 auto 36px; line-height: 1.72; }
    .cta-actions { display: flex; align-items: center; justify-content: center; gap: 16px; flex-wrap: wrap; }
    .btn-blue-solid {
      font-family: var(--font); font-size: 14px; font-weight: 600;
      padding: 13px 30px; border-radius: var(--radius); border: none; cursor: pointer;
      background: linear-gradient(135deg, #247b96, #5ba8c4);
      color: var(--white); transition: all var(--tr); display: inline-block;
    }
    .btn-blue-solid:hover { opacity: 0.88; transform: translateY(-2px); box-shadow: 0 6px 24px rgba(36,123,150,0.45); }
    .btn-ghost-dark {
      font-family: var(--font); font-size: 14px; font-weight: 500;
      background: none; border: 1.5px solid rgba(255,255,255,0.35);
      padding: 12px 26px; border-radius: var(--radius); cursor: pointer;
      color: rgba(255,255,255,0.85); display: inline-block; transition: all var(--tr);
    }
    .btn-ghost-dark:hover { border-color: rgba(255,255,255,0.8); color: var(--white); background: rgba(255,255,255,0.08); }

    @media (max-width: 1024px) {
      .article-wrap { grid-template-columns: 1fr; gap: 48px; }
      .article-sidebar { position: static; }
    }
    @media (max-width: 960px) {
      .hero { padding: 72px 24px 88px; min-height: auto; }
      .article-wrap { padding: 56px 24px; }
      .cta-band { padding: 64px 24px; }
    }
    @media (max-width: 600px) {
      .hero { padding: 56px 20px 72px; }
      .article-wrap { padding: 44px 20px; }
    }
  </style>

  <Header client:load />

  <!-- Hero -->
  <section class="hero">
    <div class="hero-inner">
      <div class="breadcrumb">
        <a href="/our-work">Our Work</a>
        <span class="breadcrumb-sep">/</span>
        <span>{heroTag}</span>
      </div>
      <div class="hero-eyebrow">
        <span class="hero-eyebrow-dot"></span>
        {heroTag}
      </div>
      <h1>{post.title}</h1>
      <div class="hero-meta">
        {publishDateFormatted && (
          <>
            <span class="hero-meta-item">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
                <rect x="3" y="4" width="18" height="18" rx="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
              {publishDateFormatted}
            </span>
            <span class="hero-meta-divider"></span>
          </>
        )}
        <span class="hero-meta-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
            <circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"></path>
          </svg>
          {readMinutes} min read
        </span>
        {post.pillarName && (
          <>
            <span class="hero-meta-divider"></span>
            <span class="hero-meta-item">{post.pillarName}</span>
          </>
        )}
      </div>
    </div>
  </section>

  <!-- Article -->
  <div class="article-wrap">
    <article class="article-body">
      <PortableText value={post.body} />
    </article>
    <aside class="article-sidebar">
      <div class="sidebar-card">
        <h4>About This Post</h4>
        <div class="sidebar-tag">{heroTag}</div>
        <div class="sidebar-meta">
          <strong>Published</strong><br />{publishDateFormatted || "Draft"}
          <div class="sidebar-divider"></div>
          <strong>Reading time</strong><br />~{readMinutes} minutes
          {post.pillarName && (
            <>
              <div class="sidebar-divider"></div>
              <strong>Pillar</strong><br />{post.pillarName}
            </>
          )}
        </div>
      </div>
      <div class="sidebar-cta">
        <h4>Ready to move from insight to action?</h4>
        <p>Let ENTEVATE help you turn strategy into measurable outcomes.</p>
        <a href="/contact" class="btn-blue">Start a Conversation</a>
      </div>
    </aside>
  </div>

  <!-- CTA Band -->
  <section class="cta-band">
    <h2>Let's build what's next together.</h2>
    <p>Every big idea starts with a conversation. Reach out and let's explore what's possible.</p>
    <div class="cta-actions">
      <a href="/contact" class="btn-blue-solid">Start a Conversation</a>
      <a href="/our-work" class="btn-ghost-dark">← More Insights</a>
    </div>
  </section>

  <Footer client:load />
</BaseLayout>
