# ==================================================
#  ENTEVATE Website environment variables
# ==================================================
#
# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit real credentials.

# --- Sanity CMS ---------------------------------------------------
# Public: exposed to the Studio client bundle. Prefixed PUBLIC_ so
# Astro/Vite treat them as safe for the browser.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
PUBLIC_SITE_URL=http://localhost:4321

# Server-only: used by build-time GROQ queries and the preview endpoint.
# Read+write API token from Sanity dashboard → API → Tokens.
# Give it "Editor" or "Deploy Studio" permissions.
SANITY_API_TOKEN=

# Random string used to sign the draft-preview cookie.
# Generate one via: openssl rand -base64 32
SANITY_PREVIEW_SECRET=

# --- Supabase (existing, used by BrandPortal signature builder) ---
# Not related to Sanity. Included for completeness of the env file.
# PUBLIC_SUPABASE_URL=
# PUBLIC_SUPABASE_ANON_KEY=
